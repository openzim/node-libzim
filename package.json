{
  "name": "@openzim/libzim",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "4.5.1-dev0",
  "description": "Libzim bindings for NodeJS",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist build/native/build",
    "tsc": "tsc",
    "prepare": "mkdir -p dist/ && cp -v src/index.js src/index.d.ts dist/",
    "codecov": "nyc --reporter=lcov npm t",
    "install": "npm run download && node-gyp rebuild -v && npm run bundle",
    "build": "node-gyp rebuild -v && npm run bundle",
    "download": "node ./download-libzim.js",
    "bundle": "node ./bundle-libzim.js",
    "test": "node --test test/zim.test.ts",
    "test-mem-leak": "node test/makeLargeZim.ts",
    "test:dist": "npm run build && node --test test/dist.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "test/*",
      "node_modules"
    ]
  },
  "author": "Joseph Reeve",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openzim/node-libzim.git"
  },
  "bugs": {
    "url": "https://github.com/openzim/node-libzim/issues"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "homepage": "https://github.com/openzim/node-libzim#readme",
  "gypfile": true,
  "dependencies": {
    "@types/node": "22 || 24 || 26",
    "bindings": "^1.5.0",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/bindings": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expect": "^30.4.1",
    "globals": "^17.7.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.5",
    "tqdm": "^2.0.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
