{
  "compilerOptions": {
    "module": "es2022",
    "lib": [
      "es6"
    ],
    "allowJs": true,
    "declaration": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "noEmit": true,
    "removeComments": false,
    "target": "es6",
    "esModuleInterop": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [
    "dist",
    "eslint.config.js"
  ]
}
